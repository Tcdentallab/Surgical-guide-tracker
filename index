// ============================================================
// ON HOLD FUNCTIONS
// ============================================================
let _holdReason='';
const HOLD_REASONS={
  'finance':'Finance',
  'medical':'Medical Clearance',
  'doctor':'Doctor Unresponsive',
  'cancelled':'Patient Cancelled',
  'missing-files':'Missing Files',
  'not-scheduled':'Not Scheduled Yet',
  'other':'Other',
};
function holdReasonLabel(r){return HOLD_REASONS[r]||r||'Unknown';}

function toggleHold(){
  if(isPartner()){toast('Not authorized to change this.');return;}
  const c=cases.find(x=>x.id===detId);if(!c)return;
  if(c.onHold){
    // Remove hold immediately
    c.onHold=false;c.holdReason='';c.holdNote='';c.holdDate='';
    persistCase(c);closeDet();render();toast('✓ Hold removed — case is active again');
  }else{
    // Open hold modal
    _holdReason='';
    document.querySelectorAll('.hold-reason-btn').forEach(b=>b.classList.remove('selected'));
    document.getElementById('holdNote').value='';
    const mc=cases.find(x=>x.id===detId);
    document.getElementById('holdModalSub').textContent=mc?mc.pt:'Select a reason';
    document.getElementById('holdOv').classList.add('open');
  }
}

function selectHoldReason(btn,reason){
  _holdReason=reason;
  document.querySelectorAll('.hold-reason-btn').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
}

function closeHold(){document.getElementById('holdOv').classList.remove('open');}

async function confirmHold(){
  if(!_holdReason){toast('Please select a reason first');return;}
  const c=cases.find(x=>x.id===detId);if(!c)return;
  c.onHold=true;
  c.holdReason=_holdReason;
  c.holdNote=document.getElementById('holdNote').value.trim();
  c.holdDate=new Date().toISOString().split('T')[0];
  await persistCase(c);
  closeHold();closeDet();render();
  toast(`⏸ Case on hold — ${holdReasonLabel(_holdReason)}`);
}

// ============================================================
// LOCK SCREEN
// ============================================================
const LOCK_KEY='sgv8_lock';
const LOCK_DAYS=7;

function getLockPass(member){
  // Use custom password if set, otherwise last 4 of Slack ID (if they have one)
  if(member.password&&member.password.trim()) return member.password.trim().toUpperCase();
  if(member.slackId) return member.slackId.slice(-4).toUpperCase();
  return null; // no valid login method for this member
}

// lockNameChanged and populateLockDropdown removed — login by password only

function doLogin(){
  const passEl=document.getElementById('lockPass');
  const errEl=document.getElementById('lockError');
  const pass=(passEl.value||'').toUpperCase().trim();
  if(!pass){errEl.textContent='Please enter your password.';return;}
  // Find matching member by password
  const member=(team.members||[]).find(m=>{const lp=getLockPass(m);return lp&&lp===pass;});
  if(!member){
    errEl.textContent='Incorrect password. Try again.';
    passEl.value='';passEl.focus();return;
  }
  // Success — store session
  const expires=Date.now()+(LOCK_DAYS*24*60*60*1000);
  localStorage.setItem(LOCK_KEY,JSON.stringify({memberId:member.id,expires}));
  currentMember=member;
  applyRoleView();
  document.getElementById('lockScreen').classList.add('hidden');
  errEl.textContent='';
  toast('Welcome, '+member.name+'!');
}

function checkLock(){
  // Must wait until team is loaded before checking
  const stored=localStorage.getItem(LOCK_KEY);
  if(stored){
    try{
      const {memberId,expires}=JSON.parse(stored);
      if(Date.now()<expires){
        // Still valid — unlock
        currentMember=(team.members||[]).find(m=>m.id===memberId)||null;
        applyRoleView();
        document.getElementById('lockScreen').classList.add('hidden');
        return;
      }
    }catch(e){}
  }
  // Show lock screen
  currentMember=null;
  document.getElementById('lockScreen').classList.remove('hidden');
  setTimeout(()=>{const p=document.getElementById('lockPass');if(p)p.focus();},100);
}

function lockOut(){
  localStorage.removeItem(LOCK_KEY);
  currentMember=null;
  document.getElementById('lockScreen').classList.remove('hidden');
  const p=document.getElementById('lockPass');if(p){p.value='';p.focus();}
  document.getElementById('lockError').textContent='';
}

function applyRoleView(){
  // Scope the UI down for partner-role logins: hide admin controls, filter the board to their own cases
  const partner=isPartner();
  const addBtn=document.getElementById('hdrAddBtn');if(addBtn)addBtn.style.display=partner?'none':'';
  const setBtn=document.getElementById('settingsBtn');if(setBtn)setBtn.style.display=partner?'none':'';
  const gcalPill=document.getElementById('gcalPill');if(gcalPill)gcalPill.style.display=partner?'none':'';
  const userEl=document.getElementById('hdrUser');if(userEl)userEl.textContent=currentMember?(currentMember.name+(partner?' · Partner':'')):'';
  switchView('dashboard');
  render();
}


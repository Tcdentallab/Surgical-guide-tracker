function addBizDays(dateStr,days){if(!dateStr)return '';let d=new Date(dateStr+'T00:00:00');let remaining=Math.abs(days);const dir=days<0?-1:1;while(remaining>0){d.setDate(d.getDate()+dir);const day=d.getDay();if(day!==0&&day!==6)remaining--;}return d.toISOString().split('T')[0];}
function shiftToFriday(dateStr){if(!dateStr)return '';const d=new Date(dateStr+'T00:00:00');const day=d.getDay();if(day===6)d.setDate(d.getDate()-1);if(day===0)d.setDate(d.getDate()-2);return d.toISOString().split('T')[0];}

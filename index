function pwWeekBounds(){
  const anchor=new Date(pwState.anchor);const dow=(anchor.getDay()+6)%7;
  const start=new Date(anchor);start.setDate(anchor.getDate()-dow);start.setHours(0,0,0,0);
  const end=new Date(start);end.setDate(start.getDate()+6);end.setHours(23,59,59,999);
  return {start,end};
}
function caseInWeek(c){
  const {start,end}=pwWeekBounds();
  let hasAnyDate=false;
  const inRange=GCAL_FIELDS.some(f=>{
    const v=c[f.key];if(!v)return false;
    hasAnyDate=true;
    const dt=new Date(v+'T00:00:00');
    return dt>=start&&dt<=end;
  });
  return hasAnyDate?inRange:true; // nothing scheduled yet — always show so it doesn't get lost
}


}
function selectStage(id){document.querySelectorAll('.stage-option').forEach(el=>el.classList.toggle('selected',el.dataset.stage===id));}
function getSelectedStage(){const el=document.querySelector('.stage-option.selected');return el?el.dataset.stage:'pre-records';}

function populateDrDropdown(selectedId){
  // Reset search field
  const si=document.getElementById('drSearchInput');
  const dd=document.getElementById('drDropdown');
  const wd=document.getElementById('w_dr');
  const dsd=document.getElementById('drSelectedDisplay');
  if(si)si.style.display='block';

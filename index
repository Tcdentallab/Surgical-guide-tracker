<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TC Dental Lab - Surgical Guide Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">
<style>
:root{--bg:#f7f8fa;--surface:#fff;--s2:#f1f3f6;--border:#dde1e7;--text:#0f172a;--muted:#64748b;--navy:#0f172a;--gold:#c8842f;--gold-lt:#faf0e0;--teal:#0e7490;--teal-lt:#dbeef2;--rose:#be123c;--rose-lt:#fbe4e9;--blue:#1d4ed8;--blue-lt:#dbe6fb;--purple:#7c3aed;--purple-lt:#ece4fc;--green:#15803d;--green-lt:#dcf4e3;--orange:#c2660c;--orange-lt:#fbe9d7;--shadow-sm:0 1px 2px rgba(15,23,42,.06);--shadow-md:0 4px 16px rgba(15,23,42,.08);--ease-out:cubic-bezier(0.23,1,0.32,1);--ease-io:cubic-bezier(0.77,0,0.175,1);}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;min-height:100vh;-webkit-font-smoothing:antialiased;}
.ph,[class^="ph-"],[class*=" ph-"]{vertical-align:-.125em;}
.lock-screen{position:fixed;inset:0;background:var(--navy);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;}
.lock-screen.hidden{display:none;}
.lock-logo{text-align:center;margin-bottom:32px;}
.lock-logo-tc{font-size:64px;font-weight:900;color:#fff;letter-spacing:-4px;line-height:1;}
.lock-logo-tc em{color:var(--blue);font-style:normal;}
.lock-logo-ring{width:80px;height:24px;border:3px solid #888;border-radius:50%;margin:4px auto;transform:rotate(-15deg);}
.lock-logo-name{font-size:22px;font-weight:800;color:#fff;margin-top:8px;letter-spacing:-0.5px;}
.lock-logo-sub{font-size:13px;color:rgba(255,255,255,.45);margin-top:4px;letter-spacing:0.5px;}
.lock-box{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:32px;width:100%;max-width:380px;}
.lock-title{font-size:18px;font-weight:700;color:#fff;margin-bottom:4px;text-align:center;}
.lock-sub{font-size:12px;color:rgba(255,255,255,.45);text-align:center;margin-bottom:24px;}
.lock-field{margin-bottom:16px;}
.lock-field label{display:block;font-size:11px;font-weight:700;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;}
.lock-field select,.lock-field input{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#fff;padding:12px 14px;border-radius:6px;font-size:14px;width:100%;outline:none;font-family:inherit;transition:border-color .15s;}
.lock-field select:focus,.lock-field input:focus{border-color:var(--blue);background:rgba(255,255,255,.12);color:#fff;}
.lock-field select option{background:var(--navy);color:#fff;}
.lock-field input::placeholder{color:rgba(255,255,255,.3);}
.lock-btn{width:100%;padding:14px;background:var(--blue);color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;margin-top:4px;}
.lock-btn:hover{background:#1e40c7;transform:translateY(-1px);}
.lock-error{font-size:12px;color:#ff8080;text-align:center;margin-top:12px;min-height:18px;}
.lock-hint{font-size:11px;color:rgba(255,255,255,.3);text-align:center;margin-top:16px;line-height:1.5;}
.hdr{background:var(--navy);height:60px;display:flex;align-items:center;padding:0 24px;gap:16px;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,.08);}
.logo{font-size:18px;font-weight:800;color:#fff;letter-spacing:-.5px;}
.logo em{color:var(--blue);font-style:normal;}
.hdr-div{width:1px;height:24px;background:rgba(255,255,255,.15);}
.hdr-title{font-size:13px;color:rgba(255,255,255,.6);font-weight:500;}
.sync-pill{display:flex;align-items:center;gap:6px;font-size:11px;padding:4px 12px;border-radius:6px;border:1px solid;white-space:nowrap;}
.sync-pill.local{background:rgba(29,78,216,.15);color:#7aadff;border-color:rgba(29,78,216,.4);}
.sync-pill.live{background:rgba(42,122,58,.15);color:#3aaa5a;border-color:rgba(42,122,58,.4);}
.sync-pill.syncing{background:rgba(42,85,160,.15);color:#6a9af0;border-color:rgba(42,85,160,.4);}
.sync-pill.error{background:rgba(192,57,74,.15);color:var(--rose);border-color:rgba(192,57,74,.4);}
.sync-dot{width:7px;height:7px;border-radius:50%;background:currentColor;}
.sync-dot.pulse{animation:pulse 1.5s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}
.hdr-right{margin-left:auto;display:flex;align-items:center;gap:10px;}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;border:none;cursor:pointer;font-size:13px;font-weight:600;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;white-space:nowrap;font-family:inherit;}
.btn-primary{background:var(--blue);color:#fff;box-shadow:0 1px 2px rgba(29,78,216,.3);}
.btn-primary:hover{background:#1e40c7;}
.btn-ghost-w{background:transparent;color:rgba(255,255,255,.65);border:1px solid rgba(255,255,255,.25);}
.btn-ghost-w:hover{border-color:#7aadff;color:#7aadff;}
.btn-navy{background:var(--navy);color:#fff;}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border);}
.btn-ghost:hover{border-color:var(--navy);color:var(--navy);}
.btn-danger{background:var(--rose-lt);color:var(--rose);border:1px solid rgba(192,57,74,.2);}
.btn-danger:hover{background:var(--rose);color:#fff;}
.btn-teal{background:var(--teal);color:#fff;}
.btn-sm{padding:6px 12px;font-size:12px;}
.btn-lg{padding:12px 24px;font-size:15px;border-radius:5px;}
.toolbar{background:var(--surface);border-bottom:2px solid var(--border);padding:10px 24px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.filter-btn{padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;font-size:12px;font-weight:600;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;white-space:nowrap;font-family:inherit;}
.filter-btn:hover{border-color:var(--navy);color:var(--navy);}
.filter-btn.active{background:var(--navy);color:#fff;border-color:var(--navy);}
.search-wrap{margin-left:auto;position:relative;}
.search-ico{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none;}
.search-box{background:var(--s2);border:1px solid var(--border);color:var(--text);padding:7px 12px 7px 32px;border-radius:8px;font-size:13px;width:220px;outline:none;font-family:inherit;transition:border-color .15s;}
.search-box:focus{border-color:var(--navy);}
.search-box::placeholder{color:var(--muted);}
.main{padding:20px 24px;}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;position:relative;overflow:hidden;transition:transform .15s,box-shadow .15s;box-shadow:var(--shadow-sm);}
.stat-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.08);cursor:pointer;}
.stat-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;}
.stat-card.c1::after{background:var(--navy);}
.stat-card.c2::after{background:var(--blue);}
.stat-card.c3::after{background:var(--teal);}
.stat-card.c4::after{background:var(--gold);}
.stat-card.c5::after{background:var(--rose);}
.stat-card.c6::after{background:var(--purple);}
.stat-card.c7::after{background:#5a6b85;}
.stat-card.c8::after{background:var(--gold);}
.stat-card.c9::after{background:var(--teal);}
.stat-num{font-size:30px;font-weight:800;line-height:1;margin-bottom:4px;}
.stat-label{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;}
.stat-icon{position:absolute;top:12px;right:12px;font-size:22px;opacity:.2;}
.board{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;align-items:start;}
.col{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:var(--shadow-sm);}
.col-head{padding:12px 14px;border-bottom:2px solid var(--border);}
.col-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;}
.col-name{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;}
.col-count{font-size:11px;background:var(--s2);color:var(--muted);padding:2px 8px;border-radius:5px;font-weight:600;}
.col-sub{font-size:10px;padding:2px 8px;border-radius:4px;font-weight:600;display:inline-block;}
.col-cards{padding:8px;display:flex;flex-direction:column;gap:8px;min-height:80px;}
.case-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px;cursor:pointer;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;position:relative;box-shadow:var(--shadow-sm);}
.case-card:hover{border-color:var(--blue);box-shadow:var(--shadow-md);transform:translateY(-1px);}
.card-accent{position:absolute;left:0;top:0;bottom:0;width:4px;border-radius:5px 0 0 5px;}
.card-id{font-size:10px;color:var(--muted);font-weight:600;margin-bottom:4px;}
.card-name{font-size:14px;font-weight:700;margin-bottom:3px;line-height:1.2;padding-right:16px;}
.card-doctor{font-size:11px;color:var(--muted);margin-bottom:8px;}
.card-badges{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:8px;}
.badge{font-size:10px;padding:2px 8px;border-radius:6px;font-weight:700;}
.badge-scan{background:var(--blue-lt);color:var(--blue);}
.badge-final{background:var(--gold-lt);color:#8a6010;}
.badge-urgent{background:var(--rose-lt);color:var(--rose);}
.badge-followup{background:var(--purple-lt);color:var(--purple);}
.badge-sub-design{background:#eeece9;color:#5a6b85;}
.badge-sub-meeting{background:var(--gold-lt);color:#8a6010;}
.badge-sub-fab{background:var(--teal-lt);color:var(--teal);}
.badge-sub-delivered{background:var(--green-lt);color:var(--green);}
.card-dates{display:flex;flex-direction:column;gap:4px;}
.date-row{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);}
.date-val{color:var(--text);font-weight:600;}
.date-val.warn{color:var(--gold);}
.date-val.hot{color:var(--rose);}
.progress-bar{height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-top:8px;}
.progress-fill{height:100%;border-radius:2px;transition:width .3s;}
.urgent-dot{position:absolute;top:10px;right:10px;width:8px;height:8px;border-radius:50%;background:var(--rose);animation:blink 1.5s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.55;}}
.empty-col{padding:16px 8px;text-align:center;color:var(--muted);font-size:12px;border:2px dashed var(--border);border-radius:4px;cursor:pointer;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;}
.empty-col:hover{border-color:var(--blue);color:var(--blue);}
.empty-col-icon{font-size:20px;margin-bottom:4px;}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:200;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px);}
.overlay.open{display:flex;}
.modal{background:var(--surface);border-radius:12px;width:100%;max-width:620px;max-height:92vh;overflow-y:auto;animation:slideUp .25s var(--ease-out);border:1px solid var(--border);box-shadow:0 24px 64px rgba(15,23,42,.25);}
@keyframes slideUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
.modal-hd{padding:24px 28px 20px;border-bottom:2px solid var(--border);display:flex;align-items:flex-start;justify-content:space-between;gap:16px;position:sticky;top:0;background:var(--surface);z-index:2;border-radius:6px 6px 0 0;}
.modal-title{font-size:20px;font-weight:800;color:var(--navy);}
.modal-sub{font-size:12px;color:var(--muted);margin-top:3px;}
.close-btn{background:var(--s2);border:1px solid var(--border);color:var(--muted);width:32px;height:32px;border-radius:4px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;flex-shrink:0;}
.close-btn:hover{color:var(--rose);border-color:var(--rose);}
.modal-body{padding:24px 28px;}
.modal-ft{padding:16px 28px;border-top:2px solid var(--border);display:flex;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:var(--surface);border-radius:0 0 6px 6px;}
.badge-draft{background:var(--s2);color:var(--muted);border:1px solid var(--border);font-size:10px;padding:2px 8px;border-radius:5px;font-weight:700;margin-left:6px;}
.wizard-steps{display:flex;align-items:center;gap:0;margin-bottom:24px;}
.wz-step{display:flex;align-items:center;gap:0;flex:1;}
.wz-dot{width:32px;height:32px;border-radius:50%;border:1px solid var(--border);background:var(--s2);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--muted);flex-shrink:0;transition:all .2s;}
.wz-dot.active{border-color:var(--navy);background:var(--navy);color:#fff;}
.wz-dot.done{border-color:var(--teal);background:var(--teal);color:#fff;}
.wz-label{font-size:10px;color:var(--muted);font-weight:600;text-align:center;margin-top:4px;white-space:nowrap;}
.wz-line{flex:1;height:2px;background:var(--border);margin:0 4px;margin-bottom:18px;}
.wz-line.done{background:var(--teal);}
.wz-node{display:flex;flex-direction:column;align-items:center;}
.wz-page{display:none;}
.wz-page.active{display:block;}
.wz-question{font-size:17px;font-weight:700;color:var(--navy);margin-bottom:6px;}
.wz-hint{font-size:12px;color:var(--muted);margin-bottom:16px;line-height:1.5;}
.field{margin-bottom:16px;}
.field label{display:block;font-size:12px;font-weight:700;color:var(--navy);margin-bottom:6px;text-transform:uppercase;letter-spacing:.4px;}
.field-hint{font-size:11px;color:var(--muted);margin-top:4px;}
input,select,textarea{background:var(--s2);border:1px solid var(--border);color:var(--text);padding:10px 14px;border-radius:8px;font-size:14px;width:100%;outline:none;transition:border-color .15s;font-family:inherit;}
input:focus,select:focus,textarea:focus{border-color:var(--navy);background:#fff;}
select option{background:var(--surface);}
textarea{resize:vertical;min-height:80px;}
.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.toggle-row{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--s2);border:1px solid var(--border);border-radius:4px;}
.toggle-info{flex:1;}
.toggle-label{font-size:14px;font-weight:600;}
.toggle-sub{font-size:11px;color:var(--muted);margin-top:2px;}
.tgl{width:44px;height:24px;background:var(--border);border-radius:6px;position:relative;cursor:pointer;transition:background .2s;flex-shrink:0;}
.tgl.on{background:var(--teal);}
.tgl::after{content:'';position:absolute;width:18px;height:18px;background:white;border-radius:50%;top:3px;left:3px;transition:transform .2s var(--ease-out);}
.tgl.on::after{transform:translateX(20px);}
.stage-picker{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.guide-picker{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.online-meet-box{background:var(--s2);border:1px solid var(--border);border-radius:5px;padding:14px;margin-bottom:16px;}
.online-meet-deadline{font-size:12px;color:var(--muted);margin-bottom:10px;padding:8px 10px;background:var(--surface);border-radius:6px;border:1px solid var(--border);}
.online-meet-deadline strong{color:var(--navy);}
.stage-option{padding:14px;border:1px solid var(--border);border-radius:5px;cursor:pointer;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;display:flex;align-items:flex-start;gap:10px;}
.stage-option:hover{border-color:var(--navy);background:var(--blue-lt);}
.stage-option.selected{border-color:var(--navy);background:var(--navy);color:#fff;}
.stage-option.selected .stage-opt-sub{color:rgba(255,255,255,.65);}
.stage-opt-icon{font-size:20px;flex-shrink:0;margin-top:1px;}
.stage-opt-name{font-size:13px;font-weight:700;margin-bottom:2px;}
.stage-opt-sub{font-size:11px;color:var(--muted);}
.detail-modal{max-width:860px;}
.detail-hd{background:var(--navy);border-radius:6px 6px 0 0;padding:24px 28px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
.detail-name{font-size:22px;font-weight:800;color:#fff;margin-bottom:4px;}
.detail-sub{font-size:12px;color:rgba(255,255,255,.5);}
.detail-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
.detail-tag{font-size:10px;padding:3px 10px;border-radius:6px;font-weight:700;}
.detail-body{padding:24px 28px;display:grid;grid-template-columns:1fr 240px;gap:20px;}
.tl-item{display:flex;gap:12px;padding-bottom:18px;position:relative;}
.tl-item::before{content:'';position:absolute;left:14px;top:28px;bottom:0;width:2px;background:var(--border);}
.tl-item:last-child::before{display:none;}
.tl-dot{width:28px;height:28px;border-radius:50%;border:1px solid var(--border);background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;z-index:1;}
.tl-dot.done{border-color:var(--teal);background:var(--teal-lt);color:var(--teal);}
.tl-dot.active{border-color:var(--gold);background:var(--gold-lt);color:#8a6010;border:2px solid var(--gold);}
.tl-dot.skip{border-color:var(--border);background:var(--s2);color:var(--muted);}
.tl-content{flex:1;padding-top:3px;}
.tl-name{font-size:13px;font-weight:700;margin-bottom:2px;}
.tl-desc{font-size:11px;color:var(--muted);margin-bottom:4px;line-height:1.5;}
.tl-chip{font-size:11px;padding:2px 8px;border-radius:5px;display:inline-block;font-weight:600;}
.tl-chip.set{background:var(--gold-lt);color:#8a6010;}
.tl-chip.done{background:var(--teal-lt);color:var(--teal);}
.tl-chip.none{background:var(--s2);color:var(--muted);}
.parallel-box{display:grid;grid-template-columns:1fr 1fr;gap:10px;border:1px solid var(--border);border-radius:5px;padding:12px;background:var(--bg);margin-bottom:18px;}
.par-head{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:3px 8px;border-radius:5px;margin-bottom:8px;display:inline-block;}
.par-item{display:flex;gap:8px;margin-bottom:8px;align-items:flex-start;}
.par-dot{width:18px;height:18px;border-radius:50%;border:1px solid var(--border);background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:8px;flex-shrink:0;margin-top:1px;}
.par-dot.done{border-color:var(--teal);background:var(--teal-lt);color:var(--teal);}
.par-dot.active{border-color:var(--gold);background:var(--gold-lt);color:#8a6010;}
.par-name{font-size:11px;font-weight:700;margin-bottom:2px;}
.par-desc{font-size:10px;color:var(--muted);}
.sidebar{display:flex;flex-direction:column;gap:12px;}
.sidebar-card{background:var(--s2);border:1px solid var(--border);border-radius:5px;padding:14px;}
.sidebar-title{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:10px;}
.info-row{display:flex;justify-content:space-between;align-items:center;padding:5px 0;font-size:12px;border-bottom:1px solid var(--border);}
.info-row:last-child{border-bottom:none;}
.info-key{color:var(--muted);}
.info-val{font-weight:600;text-align:right;}
.info-val.warn{color:var(--gold);}
.info-val.hot{color:var(--rose);}
.chip{padding:2px 8px;border-radius:5px;font-size:10px;font-weight:700;}
.chip-y{background:var(--teal-lt);color:var(--teal);}
.chip-n{background:var(--s2);color:var(--muted);border:1px solid var(--border);}
.chip-tbd{background:var(--gold-lt);color:#8a6010;}
.chip-hot{background:var(--rose-lt);color:var(--rose);}
.countdown{text-align:center;padding:8px 0;}
.countdown-num{font-size:40px;font-weight:800;line-height:1;}
.countdown-label{font-size:11px;color:var(--muted);margin-top:2px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;}
.fu-banner{margin:0 28px 16px;background:linear-gradient(135deg,var(--purple-lt),#f5f0ff);border:2px solid rgba(112,48,176,.2);border-radius:5px;padding:12px 16px;display:flex;align-items:flex-start;gap:10px;}
.fu-icon{font-size:20px;flex-shrink:0;}
.fu-title{font-size:13px;font-weight:700;color:#4a2080;margin-bottom:2px;}
.fu-sub{font-size:11px;color:var(--purple);}
.notes-section{padding:0 28px 20px;}
.notes-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:6px;}
.notes-val{background:var(--s2);border:1px solid var(--border);border-radius:4px;padding:12px;font-size:13px;line-height:1.6;min-height:44px;}
.detail-ft{padding:14px 28px;border-top:2px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.card-onhold{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;background:#fff3e0;color:#e07020;padding:2px 8px;border-radius:5px;border:1px solid rgba(224,112,32,.3);margin-left:6px;vertical-align:middle;}
.case-card.on-hold{border-left:4px solid #e07020 !important;}
.hold-modal{max-width:420px;}
.hold-reason-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
.hold-reason-btn{padding:10px 12px;border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;text-align:left;background:transparent;font-family:inherit;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;color:var(--text);}
.hold-reason-btn:hover{border-color:var(--orange);color:var(--orange);}
.hold-reason-btn.selected{border-color:var(--orange);background:#fff3e0;color:#c05010;}
.view-doctors{display:none;padding:20px 24px;}
.pw-layout{display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start;}
.pw-sidebar{position:sticky;top:76px;max-height:calc(100vh - 92px);display:flex;flex-direction:column;}
.pw-sidebar .pw-card{margin-bottom:0;overflow-y:auto;}
.pw-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-sm);padding:20px 22px;margin-bottom:22px;}
.pw-card-hd{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-bottom:16px;border-bottom:1px solid var(--border);}
.pw-card-title{font-size:17px;font-weight:800;color:var(--navy);display:flex;align-items:center;gap:8px;}
.pw-card-title i{color:var(--blue);}
.pw-nav{display:flex;align-items:center;gap:8px;}
.pw-range{font-size:12px;color:var(--muted);font-weight:700;min-width:130px;text-align:center;}
.pw-section{padding-top:18px;}
.pw-section-divider{border-top:1px solid var(--border);margin-top:18px;}
.pw-section-hd{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;}
.pw-section-hd .cal-legend{margin-bottom:0;}
.pw-section-hd .dr-hint{margin-top:0;display:flex;align-items:center;gap:4px;}
.pw-section-title{font-size:13px;font-weight:800;color:var(--navy);text-transform:uppercase;letter-spacing:.4px;display:flex;align-items:center;gap:6px;}
.pw-flag-row{display:flex;align-items:center;gap:12px;background:var(--s2);border:1px solid var(--border);border-left:4px solid var(--rose);border-radius:8px;padding:10px 14px;cursor:pointer;transition:transform .15s var(--ease-out),border-color .15s ease,box-shadow .15s ease;}
.pw-flag-row:hover{border-color:var(--blue);box-shadow:var(--shadow-sm);}
.pw-flag-row.warn{border-left-color:var(--gold);}
.pw-flag-row.hold{border-left-color:var(--orange);}
.dr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin-top:16px;}
.dr-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px;position:relative;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;box-shadow:var(--shadow-sm);}
.dr-card:hover{border-color:var(--blue);box-shadow:var(--shadow-md);}
.dr-bar{position:absolute;left:0;top:0;bottom:0;width:4px;border-radius:6px 0 0 6px;background:var(--navy);}
.dr-name{font-size:16px;font-weight:800;margin-bottom:2px;}
.dr-practice{font-size:12px;color:var(--muted);margin-bottom:12px;}
.dr-info{display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:6px;color:var(--muted);}
.dr-cases{font-size:12px;color:var(--muted);margin-top:10px;padding-top:10px;border-top:1px solid var(--border);}
.dr-cases strong{color:var(--navy);}
.dr-actions{display:flex;gap:8px;margin-top:10px;}
.dr-hint{font-size:12px;color:var(--blue);margin-top:5px;cursor:pointer;font-weight:600;}
.dr-hint:hover{text-decoration:underline;}
.dr-preview{background:var(--blue-lt);border:2px solid rgba(42,85,160,.2);border-radius:4px;padding:10px 12px;margin-top:8px;font-size:12px;display:none;line-height:1.6;}
.dr-preview-name{font-weight:700;color:var(--navy);margin-bottom:3px;font-size:13px;}
.case-card.dragging{opacity:.35;transform:scale(.96);}
.col-cards.drag-over{background:rgba(42,85,160,.05);border-radius:4px;outline:3px dashed var(--blue);}
.stage-confirm-modal{max-width:420px;}
.confirm-body{padding:24px 28px;}
.confirm-patient{font-size:12px;color:var(--muted);margin-bottom:12px;}
.confirm-stages{display:flex;align-items:center;gap:10px;}
.confirm-from{flex:1;padding:10px 14px;background:var(--s2);border-radius:4px;font-size:13px;font-weight:600;}
.confirm-to{flex:1;padding:10px 14px;border-radius:4px;font-size:13px;font-weight:700;}
.confirm-warn{font-size:12px;color:var(--orange);background:var(--orange-lt);border:1px solid rgba(224,112,32,.3);border-radius:4px;padding:10px 12px;margin-top:12px;line-height:1.5;}
.settings-tabs{display:flex;gap:4px;margin-bottom:20px;background:var(--s2);padding:4px;border-radius:5px;}
.settings-tab{flex:1;padding:8px;text-align:center;border-radius:4px;cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;border:none;background:transparent;font-family:inherit;}
.settings-tab.active{background:var(--navy);color:#fff;}
.settings-tab-body{display:none;}
.settings-tab-body.active{display:block;}
.cfg-field{margin-bottom:14px;}
.cfg-field label{display:block;font-size:12px;font-weight:700;color:var(--navy);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
.cfg-hint{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.5;}
.cfg-hint a{color:var(--blue);}
.cfg-status{padding:10px 14px;border-radius:4px;font-size:12px;margin-bottom:14px;display:none;font-weight:600;}
.cfg-status.show{display:block;}
.cfg-status.ok{background:var(--teal-lt);color:var(--teal);border:2px solid rgba(42,122,106,.2);}
.cfg-status.err{background:var(--rose-lt);color:var(--rose);border:2px solid rgba(192,57,74,.2);}
.setup-step{display:flex;gap:12px;margin-bottom:16px;align-items:flex-start;}
.step-num{width:26px;height:26px;border-radius:50%;background:var(--navy);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.step-body{flex:1;}
.step-title{font-size:13px;font-weight:700;margin-bottom:3px;}
.step-desc{font-size:11px;color:var(--muted);line-height:1.6;}
.step-desc code{background:var(--s2);padding:1px 5px;border-radius:4px;font-size:11px;}
.import-drop{border:3px dashed var(--border);border-radius:5px;padding:24px;text-align:center;cursor:pointer;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;margin-top:8px;}
.import-drop:hover{border-color:var(--teal);background:var(--teal-lt);}
.import-drop-icon{font-size:28px;margin-bottom:6px;}
.import-drop-title{font-size:14px;font-weight:700;margin-bottom:3px;}
.import-drop-sub{font-size:12px;color:var(--muted);}
.hdr-nav{display:flex;align-items:stretch;gap:2px;margin-left:4px;}
.nav-tab{padding:0 16px;display:flex;align-items:center;color:rgba(255,255,255,.5);cursor:pointer;font-size:12px;font-weight:600;border-bottom:3px solid transparent;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;white-space:nowrap;font-family:inherit;background:transparent;border-left:none;border-right:none;border-top:none;}
.nav-tab:hover{color:rgba(255,255,255,.85);}
.nav-tab.active{color:#7aadff;border-bottom-color:#7aadff;}
.toast{position:fixed;bottom:24px;right:24px;background:var(--navy);color:#fff;padding:12px 20px;border-radius:5px;font-size:13px;font-weight:600;z-index:999;animation:toastIn .25s var(--ease-out);border:1px solid rgba(255,255,255,.15);max-width:320px;}
@keyframes toastIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.gcal-pill{display:flex;align-items:center;gap:6px;font-size:11px;padding:4px 12px;border-radius:6px;border:1px solid;white-space:nowrap;cursor:pointer;transition:transform .15s var(--ease-out),background-color .18s ease,border-color .15s ease,color .15s ease,box-shadow .2s ease;}
.gcal-pill.off{background:rgba(255,255,255,.06);color:rgba(255,255,255,.4);border-color:rgba(255,255,255,.15);}
.gcal-pill.off:hover{border-color:#7aadff;color:#7aadff;}
.gcal-pill.on{background:rgba(66,133,244,.18);color:#7aadff;border-color:rgba(66,133,244,.35);}
.dr-search-wrap{position:relative;}
.dr-search-input{background:var(--s2);border:1px solid var(--border);color:var(--text);padding:10px 14px;border-radius:8px;font-size:14px;width:100%;outline:none;font-family:inherit;transition:border-color .15s;}
.dr-search-input:focus{border-color:var(--navy);background:#fff;}
.dr-search-input::placeholder{color:var(--muted);}
.dr-dropdown{position:absolute;top:100%;left:0;right:0;background:var(--surface);border:2px solid var(--navy);border-top:none;border-radius:0 0 8px 8px;max-height:220px;overflow-y:auto;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.15);display:none;}
.dr-dropdown.open{display:block;}
.dr-option{padding:10px 14px;cursor:pointer;font-size:13px;border-bottom:1px solid var(--border);transition:background .1s;}
.dr-option:hover{background:var(--blue-lt);}
.dr-option:last-child{border-bottom:none;}
.dr-option-name{font-weight:600;color:var(--navy);}
.dr-option-practice{font-size:11px;color:var(--muted);}
.dr-selected{padding:10px 14px;background:var(--blue-lt);border:2px solid var(--navy);border-radius:8px;font-size:13px;font-weight:600;color:var(--navy);cursor:pointer;display:flex;align-items:center;justify-content:space-between;}
@media(max-width:1100px){.pw-layout{grid-template-columns:1fr;}.pw-sidebar{position:static;max-height:none;}}
@media(max-width:1000px){.stats{grid-template-columns:repeat(4,1fr);}}
@media(max-width:700px){.stats{grid-template-columns:repeat(2,1fr);}.detail-body{grid-template-columns:1fr;}.parallel-box{grid-template-columns:1fr;}}
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:var(--s2);}
.cal-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px;}
.cal-nav{display:flex;align-items:center;gap:12px;}
.cal-nav-btn{background:var(--s2);border:1px solid var(--border);border-radius:4px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);font-size:14px;font-family:inherit;}
.cal-nav-btn:hover{border-color:var(--navy);color:var(--navy);}
.cal-range-label{font-size:14px;font-weight:700;color:var(--navy);min-width:150px;text-align:center;}
.cal-today-btn{padding:5px 12px;font-size:11px;font-weight:700;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--muted);cursor:pointer;font-family:inherit;}
.cal-today-btn:hover{border-color:var(--navy);color:var(--navy);}
.cal-legend{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px;}
.cal-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted);font-weight:600;}
.cal-legend-dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex-shrink:0;}
.cal-week-label{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:16px 0 8px;}
.cal-week-label:first-child{margin-top:0;}
.cal-week{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;}
.cal-daycol{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:10px;min-height:220px;}
.cal-daycol.cal-cell-today{border-color:var(--gold);}
.cal-daylabel{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;}
.cal-chip{font-size:11px;font-weight:600;padding:5px 8px;border-radius:5px;margin-bottom:5px;cursor:pointer;line-height:1.4;}
.cal-chip-list:empty::after{content:'—';font-size:11px;color:var(--muted);}
.cal-chip-untracked{display:block;background:var(--s2);color:var(--muted);border:1px dashed var(--border);text-decoration:none;font-weight:500;}
.cal-chip-untracked:hover{border-color:var(--navy);color:var(--navy);}

/* --- press feedback (:active) --- */
.btn:active,.filter-btn:active,.stage-option:active,.settings-tab:active,.hold-reason-btn:active,.close-btn:active,.nav-tab:active,.gcal-pill:active,.empty-col:active,.dr-card:active{transform:scale(.97);}
.case-card:active{transform:scale(.985);}
.stat-card:active{transform:translateY(0) scale(.985);}
.lock-btn:active{transform:translateY(0) scale(.98);}
/* --- keyboard focus visibility (was outline:none only) --- */
.btn:focus-visible,.filter-btn:focus-visible,.nav-tab:focus-visible,.settings-tab:focus-visible,.close-btn:focus-visible,.hold-reason-btn:focus-visible,.stage-option:focus-visible,.gcal-pill:focus-visible,.lock-btn:focus-visible,.empty-col:focus-visible{outline:2px solid var(--blue);outline-offset:2px;}
input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--navy);outline-offset:1px;}
/* --- don't let transform-hovers stick on touch devices --- */
@media (hover:none){.stat-card:hover{transform:none;box-shadow:none;cursor:default;}.lock-btn:hover{transform:none;}}
/* --- respect reduced-motion --- */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}
  .sync-dot.pulse,.urgent-dot{animation:none!important;}
}
</style>
</head>
<body>

<!-- LOCK SCREEN -->
<div class="lock-screen" id="lockScreen">
  <div class="lock-logo">
    <div style="margin:0 auto 12px;text-align:center;">
      <span style="font-size:72px;font-weight:900;color:#fff;letter-spacing:-4px;line-height:1;">T<span style="color:var(--blue);">C</span></span>
    </div>
    <div class="lock-logo-name">Dental Lab</div>
    <div class="lock-logo-sub">All-on-X Digital Solution</div>
  </div>
  <div class="lock-box">
    <div class="lock-title">Surgical Guide Tracker</div>
    <div class="lock-sub">Enter your password to continue</div>
    <div class="lock-field">
      <label>Password</label>
      <input type="password" id="lockPass" placeholder="Enter your password" onkeydown="if(event.key==='Enter')doLogin()" autofocus>
    </div>
    <button class="lock-btn" onclick="doLogin()">Sign In →</button>
    <div class="lock-error" id="lockError"></div>
    <div class="lock-hint">Password is the last 4 characters of your Slack ID (or your assigned PIN).<br>Contact your manager if you need help.</div>
  </div>
</div>

<div class="hdr">
  <div class="logo">TC Dental <em>Lab</em></div>
  <div class="hdr-div"></div>
  <div class="hdr-title">Surgical Guide Tracker</div>
  <div class="hdr-div"></div>
  <nav class="hdr-nav">
    <button class="nav-tab active" id="nav-dashboard" onclick="switchView('dashboard')"><i class="ph-bold ph-squares-four"></i> Dashboard</button>
    <button class="nav-tab" id="nav-cases" onclick="switchView('cases')"><i class="ph ph-kanban"></i> Cases</button>
    <button class="nav-tab" id="nav-doctors" onclick="switchView('doctors')"><i class="ph ph-stethoscope"></i> Doctors</button>
    <button class="nav-tab" id="nav-calendar" onclick="switchView('calendar')"><i class="ph ph-calendar-blank"></i> Calendar</button>
  </nav>
  <div class="sync-pill local" id="syncPill"><div class="sync-dot"></div><span id="syncLabel">Local mode</span></div>
  <div class="hdr-right">
    <span style="font-size:11px;color:rgba(255,255,255,.4);" id="hdrCount">0 cases</span>
    <span style="font-size:11px;color:rgba(255,255,255,.45);" id="hdrUser"></span>
    <button class="btn btn-ghost-w btn-sm" onclick="lockOut()" title="Sign out"><i class="ph ph-sign-out"></i></button>
    <div class="gcal-pill off" id="gcalPill" onclick="openSettings('gcal')"><i class="ph ph-calendar-blank"></i> <span id="gcalLabel">Calendar</span></div>
    <div class="hdr-div"></div>
    <button class="btn btn-ghost-w btn-sm" id="settingsBtn" onclick="openSettings()"><i class="ph ph-gear"></i> Settings</button>
    <button class="btn btn-primary btn-sm" id="hdrAddBtn" onclick="openWizard()"><i class="ph ph-plus"></i> New Case</button>
  </div>
</div>
<div class="toolbar" id="mainToolbar">
  <span style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Filter:</span>
  <button class="filter-btn active" onclick="setFilter('all',this)">All Cases</button>
  <button class="filter-btn" onclick="setFilter('pre-records',this)">New Case</button>
  <button class="filter-btn" onclick="setFilter('in-prep',this)">In Progress</button>
  <button class="filter-btn" onclick="toggleMoreFilters()" id="filtersToggleBtn" style="border-style:dashed;">More filters ▾</button>
  <span id="filtersMore" style="display:none;">
    <button class="filter-btn" onclick="setFilter('sub-design',this)"><i class="ph ph-palette"></i> Waiting on Design</button>
    <button class="filter-btn" onclick="setFilter('sub-meeting',this)"><i class="ph ph-pencil-simple"></i> Waiting on Meeting</button>
    <button class="filter-btn" onclick="setFilter('sub-fab',this)"><i class="ph ph-hammer"></i> Fabricating</button>
    <button class="filter-btn" onclick="setFilter('surgery-soon',this)">Surgery Soon</button>
    <button class="filter-btn" onclick="setFilter('post-surgery',this)">After Surgery</button>
    <button class="filter-btn" onclick="setFilter('final-fu',this)">Need Follow-up</button>
    <button class="filter-btn" onclick="setFilter('scan-appl',this)">Scan Appliance</button>
    <button class="filter-btn" onclick="setFilter('long',this)">4+ Months Out</button>
    <button class="filter-btn" onclick="setFilter('on-hold',this)"><i class="ph ph-pause"></i> On Hold</button>
  </span>
  <div class="search-wrap"><span class="search-ico"><i class="ph ph-magnifying-glass"></i></span><input class="search-box" type="text" placeholder="Search patient, doctor..." id="searchBox" oninput="render()"></div>
</div>
<div class="main view-dashboard active" id="view-dashboard">
  <div class="pw-layout">
    <div class="pw-main">
      <div class="pw-card">
        <div class="pw-card-hd">
          <div class="pw-card-title"><i class="ph-bold ph-squares-four"></i> Weekly Dashboard</div>
          <div class="pw-nav">
            <button class="cal-nav-btn" onclick="pwNav(-1)"><i class="ph ph-caret-left"></i></button>
            <div class="pw-range" id="pwRange"></div>
            <button class="cal-nav-btn" onclick="pwNav(1)"><i class="ph ph-caret-right"></i></button>
            <button class="cal-today-btn" onclick="pwToday()">Today</button>
          </div>
        </div>
        <div class="pw-section">
          <div class="pw-section-hd">
            <div class="pw-section-title"><i class="ph ph-calendar-blank"></i> This Week</div>
            <div class="cal-legend" id="pwLegend"></div>
            <span class="dr-hint" onclick="switchView('calendar')"><i class="ph ph-arrow-square-out"></i> Full calendar</span>
          </div>
          <div class="cal-week" id="pwWeekGrid"></div>
        </div>
      </div>
      <div class="stats" id="wk_statsMain" style="grid-template-columns:repeat(3,1fr);">
        <div class="stat-card c1" onclick="switchView('cases');statFilter('active')" title="Click to view in Cases"><div class="stat-icon"><i class="ph ph-kanban"></i></div><div class="stat-num" id="wk_s1" style="color:var(--navy)">0</div><div class="stat-label">Active This Week</div></div>
        <div class="stat-card c2" onclick="switchView('cases');statFilter('pre-records')" title="Click to view in Cases"><div class="stat-icon"><i class="ph ph-calendar-blank"></i></div><div class="stat-num" id="wk_s2" style="color:var(--blue)">0</div><div class="stat-label">Awaiting Records</div></div>
        <div class="stat-card c5" onclick="switchView('cases');statFilter('surgery-soon')" title="Click to view in Cases"><div class="stat-icon"><i class="ph ph-lightning"></i></div><div class="stat-num" id="wk_s5" style="color:var(--rose)">0</div><div class="stat-label">Surgery Coming Up</div></div>

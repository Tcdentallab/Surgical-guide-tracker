  if(dateVal&&c.onlineMeetStatus!=='completed'){
    c.onlineMeetStatus='scheduled';
  }else if(!dateVal&&c.onlineMeetStatus==='scheduled'){
    c.onlineMeetStatus='not-scheduled';
  }
  await persistCase(c);
  if(dateVal&&!hadDate){
    notifySlack(c,`🕐 Online Meeting scheduled for *${fmt(dateVal)}* (marked from case screen).`);
    toast('✓ Meeting date saved — assignee notified');
  }else if(dateVal){
    notifySlack(c,`🕐 Online Meeting date updated to *${fmt(dateVal)}*.`);
    toast('✓ Meeting date updated');
  }else{
    toast('Meeting date cleared');
  }
  render();openDet(id);
}


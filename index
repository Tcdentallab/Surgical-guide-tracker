  g('s3a').textContent=f.filter(c=>c.stage==='surgery-prep'&&subStatus(c)?.cls==='badge-sub-design').length;
  g('s3b').textContent=f.filter(c=>c.stage==='surgery-prep'&&subStatus(c)?.cls==='badge-sub-meeting').length;
  g('s3c').textContent=f.filter(c=>c.stage==='surgery-prep'&&subStatus(c)?.cls==='badge-sub-fab').length;
  g('s4').textContent=f.filter(c=>{const d=du(c.delDate);return d!==null&&d<=7&&d>=0;}).length;
  g('s5').textContent=f.filter(c=>{const d=du(c.surDate);return d!==null&&d<=14&&d>=0;}).length;
  g('s6').textContent=f.filter(c=>c.trackFinal&&c.finDec==='pending').length;
  const s7=g('s7');if(s7)s7.textContent=f.filter(c=>c.onHold).length;
}

function onlineMeetLabel(c){
  if(c.onlineMeetStatus==='completed') return '✓ Online Meeting w/ Doctor — Done';
  if(c.onlineMeetStatus==='scheduled'||c.onlineMeetDate) return '<i class="ph ph-clock"></i> Online Meeting w/ Doctor — Scheduled';
  return '<i class="ph ph-calendar-blank"></i> Schedule Online Meeting w/ Doctor';
}
function onlineMeetDesc(c){
  if(c.onlineMeetStatus==='completed') return `Completed${c.onlineMeetDate?' · '+fmt(c.onlineMeetDate):''}`;
  if(c.onlineMeetStatus==='scheduled'||c.onlineMeetDate) return `Meeting booked for ${fmt(c.onlineMeetDate)}${c.meetDeadline?' · deadline '+fmt(c.meetDeadline):''}`;
  return `Not booked yet — contact the doctor's office to schedule${c.meetDeadline?' · deadline '+fmt(c.meetDeadline):''}`;
}

async function saveDraft(){
  const pt=document.getElementById('w_pt').value.trim();
  if(!pt){toast('Please enter at least the patient name before saving');return;}
  const btn=document.getElementById('wizDraftBtn');
  btn.textContent='Saving...';btn.disabled=true;
  const existing=editId?cases.find(x=>x.id===editId):null;
  let draftId=editId||gv('w_id')||genId();
  if(!editId) draftId=uniqueCaseId(draftId);
  const data={
    ...(existing||{}),
    id:draftId,pt,
    dr:gv('w_dr'),stage:getSelectedStage(),
    guideType:selectedGuideType,assignedTo:gv('w_assignedTo'),
    recDate:gv('w_recDate'),recStatus:gv('w_recStatus')||'not-scheduled',
    onlineMeetDate:gv('w_onlineMeetDate'),onlineMeetStatus:gv('w_onlineMeetStatus')||'not-scheduled',
    meetDeadline:_lastMeetDeadline||'',
    surDate:gv('w_surDate'),surStatus:gv('w_surStatus')||'not-scheduled',
    schedNotes:gv('w_schedNotes'),recDone:gv('w_recDone'),
    filesStatus:gv('w_filesStatus')||'pending',filesNotes:gv('w_filesNotes'),
    needsScan:tgls.scan,scanOrd:gv('w_scanOrd'),scanRec:gv('w_scanRec'),
    prepNotes:'',meetDate:gv('w_meetDate'),meetStatus:gv('w_meetStatus')||'not-scheduled',
    fabStart:gv('w_fabStart'),fabEnd:gv('w_fabEnd'),delDate:gv('w_delDate'),
    surDone:'',delStatus:gv('w_delStatus')||'pending',surNotes:'',
    fuDate:'',fuStatus:'pending',fuNotes:'',
    trackFinal:tgls.final,finDec:gv('w_finDec')||'pending',
    finDecDate:gv('w_finFollowDate'),finFabStart:gv('w_finFabStart'),
    finFabDel:gv('w_finFabDel'),finNotes:gv('w_finNotes'),
    notes:gv('w_notes'),
    isDraft:true,
    createdAt:existing?.createdAt||new Date().toISOString().split('T')[0],
  };
  await persistCase(data);
  btn.innerHTML='<i class="ph ph-floppy-disk"></i> Save Draft';btn.disabled=false;

function buildStagePicker(){
  const el=document.getElementById('stagePicker');
  const stIcon=id=>id==='pre-records'?'ph-clipboard-text':id==='records-appt'?'ph-calendar-check':id==='surgery-prep'?'ph-hammer':id==='surgery-appt'?'ph-first-aid-kit':id==='mid-surgery-fu'?'ph-calendar-blank':id==='final-resto'?'ph-tooth':'ph-heart';
  el.innerHTML=STAGES.map(st=>`<div class="stage-option" data-stage="${st.id}" onclick="selectStage('${st.id}')"><div class="stage-opt-icon" style="color:${st.color}"><i class="ph ${stIcon(st.id)}"></i></div><div><div class="stage-opt-name">${st.label}</div><div class="stage-opt-sub"${st.id==='surgery-prep'?' id="stageSubText"':''}>${st.sub}</div></div></div>`).join('');
  selectStage('pre-records');

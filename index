<script>
const STAGES=[
  {id:'pre-records',label:'New Case',sub:'Scheduling',color:'#3b82f6',subStyle:'background:var(--blue-lt);color:var(--blue)'},
  {id:'records-appt',label:'Records Appointment',sub:'Scheduling',color:'#1d4ed8',subStyle:'background:var(--blue-lt);color:var(--blue)'},
  {id:'surgery-prep',label:'Making the Guide',sub:'Lab + Prep',color:'#c8842f',subStyle:'background:var(--gold-lt);color:#8a6010'},
  {id:'surgery-appt',label:'Surgery Day',sub:'Scheduling',color:'#0e7490',subStyle:'background:var(--teal-lt);color:var(--teal)'},
  {id:'healing',label:'Healing',sub:'Post Surgery',color:'#155e75',subStyle:'background:var(--teal-lt);color:#0c4a5e'},
  {id:'mid-surgery-fu',label:'Post-Surgery Records',sub:'After Surgery',color:'#7c3aed',subStyle:'background:var(--purple-lt);color:var(--purple)'},
  {id:'final-resto',label:'Final Restoration',sub:'After Surgery',color:'#be123c',subStyle:'background:var(--rose-lt);color:var(--rose)'},
];
const SCHEMA=[
  {name:'Case ID',key:'id'},{name:'Patient Name',key:'pt'},{name:'Doctor',key:'dr'},
  {name:'Stage',key:'stage'},{name:'Records Appt Date',key:'recDate'},{name:'Records Status',key:'recStatus'},
  {name:'Surgery Date',key:'surDate'},{name:'Surgery Status',key:'surStatus'},{name:'Scheduling Notes',key:'schedNotes'},
  {name:'Records Done Date',key:'recDone'},{name:'Files Status',key:'filesStatus'},{name:'Files Notes',key:'filesNotes'},
  {name:'Needs Scan Appliance',key:'needsScan'},{name:'Scan Ordered',key:'scanOrd'},{name:'Scan Received',key:'scanRec'},
  {name:'Prep Notes',key:'prepNotes'},{name:'Guide Type',key:'guideType'},
  {name:'Online Meeting Deadline',key:'meetDeadline'},{name:'Online Meeting Date',key:'onlineMeetDate'},{name:'Online Meeting Status',key:'onlineMeetStatus'},
  {name:'Technician Design Finished Date',key:'meetDate'},{name:'Design Status',key:'meetStatus'},
  {name:'Fab Start',key:'fabStart'},{name:'Fab End',key:'fabEnd'},{name:'Delivery Date',key:'delDate'},
  {name:'Surgery Done Date',key:'surDone'},{name:'Delivery Status',key:'delStatus'},{name:'Surgery Notes',key:'surNotes'},
  {name:'Follow-up Date',key:'fuDate'},{name:'Follow-up Status',key:'fuStatus'},{name:'Follow-up Notes',key:'fuNotes'},
  {name:'Track Final Resto',key:'trackFinal'},{name:'Final Restoration Decision',key:'finDec'},{name:'Final Decision Date',key:'finDecDate'},
  {name:'Final Fab Start',key:'finFabStart'},{name:'Final Fab Delivery',key:'finFabDel'},{name:'Final Notes',key:'finNotes'},
  {name:'Notes',key:'notes'},{name:'Created At',key:'createdAt'},
];
let cases=[],doctors=[],team={webhookUrl:'',members:[]},cfg={},gcalCfg={};
let currentMember=null;
function isPartner(){return !!(currentMember&&currentMember.role==='partner');}
let editId=null,detId=null,drEditId=null,activeFilter='all',wizPage=1;
let tgls={scan:false,final:false},csvImportData=[],dragCaseId=null,dragTargetStage=null;
let selectedGuideType=null,_lastMeetDeadline=null;
let _sha={cases:null,doctors:null,team:null,casesLoaded:false};
const LOCAL_KEY='sgv8_cases',DR_KEY='sgv8_doctors',TEAM_KEY='sgv8_team';
const SLACK_CHANNEL='C0BLG2N38AV'; // #case-tracker-alerts

function isConnected(){return !!(cfg.token&&cfg.owner&&cfg.repo);}
function setSyncPill(s,l){const p=document.getElementById('syncPill'),lb=document.getElementById('syncLabel');p.className='sync-pill '+s;lb.textContent=l;p.querySelector('.sync-dot').className='sync-dot'+(s==='syncing'?' pulse':'');}
function ghUrl(p){return `https://api.github.com/repos/${cfg.owner}/${cfg.repo}/contents/${p}`;}
function ghHdrs(){return {'Authorization':'token '+cfg.token,'Accept':'application/vnd.github.v3+json','Content-Type':'application/json'};}
async function ghRead(path){const r=await fetch(ghUrl(path),{headers:ghHdrs()});if(r.status===404)return{content:null,sha:null};if(!r.ok)throw new Error(`GitHub read failed: ${r.status}`);const d=await r.json();return{content:JSON.parse(atob(d.content.replace(/\n/g,''))),sha:d.sha};}
async function ghWrite(path,data,sha,msg){const body={message:msg,content:btoa(unescape(encodeURIComponent(JSON.stringify(data,null,2)))),branch:cfg.branch||'main'};if(sha)body.sha=sha;const r=await fetch(ghUrl(path),{method:'PUT',headers:ghHdrs(),body:JSON.stringify(body)});if(!r.ok){const e=await r.json();throw new Error(e.message||'Write failed');}return r.json();}

async function loadCases(){
  doctors=JSON.parse(localStorage.getItem(DR_KEY)||'[]');
  team=JSON.parse(localStorage.getItem(TEAM_KEY)||'{}');
// Pre-load defaults if not set
// Slack webhook must be configured per-workspace in Settings — no hardcoded default (was flagged as an exposed secret).
if(!team.members||!team.members.length) team.members=[
  {id:'TM-ASHLEY',name:'Ashley Stieben',slackId:'U0BL64ASS2D'},
  {id:'TM-DAVID',name:'David Mai',slackId:'U01F34ECN06'},
  {id:'TM-PETER',name:'Peter Phan',slackId:'U01FJ79E9N0'},
  {id:'TM-YANA',name:'Yana',slackId:'U049E611VE3'},
  {id:'TM-ARINA',name:'Arina Cazac',slackId:'U08JXGG7VEU'},
  {id:'TM-ANDREI',name:'Andrei Slatineanu',slackId:'U01JX34UZNU'},
];
localStorage.setItem(TEAM_KEY,JSON.stringify(team));
  if(!isConnected()){cases=JSON.parse(localStorage.getItem(LOCAL_KEY)||'[]');if(!cases.length)seedData();setSyncPill('local','Local mode');render();renderDoctors();checkLock();return;}
  setSyncPill('syncing','Loading...');
  try{
    const[cr,dr,tr]=await Promise.all([ghRead('cases.json'),ghRead('doctors.json'),ghRead('team.json')]);
    cases=cr.content||[];doctors=dr.content||[];team=tr.content||{};_sha.cases=cr.sha;_sha.doctors=dr.sha;_sha.team=tr.sha;_sha.casesLoaded=true;
    // Apply hardcoded defaults if team.json is empty
    // Slack webhook must be configured per-workspace in Settings — no hardcoded default (was flagged as an exposed secret).
    if(!team.members||!team.members.length) team.members=[
      {id:'TM-ASHLEY',name:'Ashley Stieben',slackId:'U0BL64ASS2D'},
      {id:'TM-DAVID',name:'David Mai',slackId:'U01F34ECN06'},
      {id:'TM-PETER',name:'Peter Phan',slackId:'U01FJ79E9N0'},
      {id:'TM-YANA',name:'Yana',slackId:'U049E611VE3'},
      {id:'TM-ARINA',name:'Arina Cazac',slackId:'U08JXGG7VEU'},
      {id:'TM-ANDREI',name:'Andrei Slatineanu',slackId:'U01JX34UZNU'},
    ];
    localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));localStorage.setItem(DR_KEY,JSON.stringify(doctors));localStorage.setItem(TEAM_KEY,JSON.stringify(team));
    setSyncPill('live','GitHub live ✓');render();renderDoctors();checkLock();
  }catch(e){
    setSyncPill('error','Sync error — reload needed');
    _sha.casesLoaded=false;
    cases=JSON.parse(localStorage.getItem(LOCAL_KEY)||'[]');doctors=JSON.parse(localStorage.getItem(DR_KEY)||'[]');
    render();renderDoctors();checkLock();
    toast('⚠ Could not reach GitHub. Showing your last saved copy — please reload the page before adding new cases.');
  }
}
async function persistTeam(msg){localStorage.setItem(TEAM_KEY,JSON.stringify(team));if(!isConnected())return;if(!_sha.casesLoaded){toast('⚠ Saved locally only. Please reload the page to reconnect to GitHub.');return;}try{const res=await ghWrite('team.json',team,_sha.team,msg||'Update team');_sha.team=res.content.sha;}catch(e){toast('Team settings saved locally — GitHub sync failed');}}

let _writeQueue=Promise.resolve();
async function _persistCaseCore(c){
  const idx=cases.findIndex(x=>x.id===c.id);if(idx!==-1)cases[idx]=c;else cases.push(c);
  localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));
  if(!isConnected())return;
  if(!_sha.casesLoaded){
    setSyncPill('error','Not synced — reload page');
    toast('⚠ Saved locally only. Please reload the page to reconnect to GitHub before this case syncs to the team.');
    return;
  }
  _writeQueue=_writeQueue.then(async()=>{
    setSyncPill('syncing','Saving...');
    try{
      const fresh=await ghRead('cases.json');
      if(fresh.sha)_sha.cases=fresh.sha;
      const ghCases=fresh.content||[];
      const merged=[...ghCases];
      cases.forEach(lc=>{const i=merged.findIndex(x=>x.id===lc.id);if(i!==-1)merged[i]=lc;else merged.push(lc);});
      cases=merged;localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));
      const res=await ghWrite('cases.json',cases,_sha.cases,`Update case ${c.id}`);
      _sha.cases=res.content.sha;setSyncPill('live','GitHub live ✓');render();
    }catch(e){setSyncPill('error','Save failed');toast('Saved locally — GitHub sync failed');}
  });
  return _writeQueue;
}
async function persistCase(c){
  const r=await _persistCaseCore(c);
  if(gcalIsConnected())gcalSyncCase(c).catch(()=>{}); // fire-and-forget — never blocks the case save itself
  return r;
}
async function persistDoctors(msg){localStorage.setItem(DR_KEY,JSON.stringify(doctors));if(!isConnected())return;if(!_sha.casesLoaded){toast('⚠ Saved locally only. Please reload the page to reconnect to GitHub.');return;}setSyncPill('syncing','Saving...');try{const res=await ghWrite('doctors.json',doctors,_sha.doctors,msg||'Update doctors');_sha.doctors=res.content.sha;setSyncPill('live','GitHub live ✓');}catch(e){setSyncPill('error','Save failed');}}
async function removeCase(c){
  cases=cases.filter(x=>x.id!==c.id);
  localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));
  if(!isConnected())return;
  if(!_sha.casesLoaded){toast('⚠ Deleted locally only. Please reload the page to reconnect to GitHub.');return;}

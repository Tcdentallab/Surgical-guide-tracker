// ============================================================
// GOOGLE CALENDAR — full 2-way sync (Authorization Code + PKCE)
// Push (tracker -> Google) is instant on save.
// Pull (Google -> tracker) happens on load and on a 5-min poll,
// since a static single-file app has no server to receive push webhooks.
// ============================================================
let gcalTokens={access:null,refresh:null,expires:0};
const GCAL_TOK_KEY='sgv8_gcal_tok';
const GCAL_FIELDS=[
  {key:'recDate',label:'Records Appointment'},
  {key:'onlineMeetDate',label:'Design Meeting'},
  {key:'surDate',label:'Surgery Day'},
  {key:'delDate',label:'Delivery'},
  {key:'fuDate',label:'Follow-up'},
  {key:'finDecDate',label:'Final Decision'},
];
const CAL_COLORS={recDate:'#1d4ed8',onlineMeetDate:'#c8842f',surDate:'#be123c',delDate:'#0e7490',fuDate:'#7c3aed',finDecDate:'#15803d'};

// ============================================================
// CALENDAR VIEW (Month / Week) — reads the same case dates GCAL_FIELDS
// syncs to Google, so what's on screen here always matches what's pushed.
// ============================================================
let calState={anchor:new Date()};

function calBuildIndex(){
  const idx={};
  cases.forEach(c=>{
    GCAL_FIELDS.forEach(f=>{
      const d=c[f.key];if(!d)return;
      if(!idx[d])idx[d]=[];
      idx[d].push({caseId:c.id,name:c.pt||'Unnamed',type:f.key,label:f.label});
    });
  });
  return idx;
}
function calRenderLegend(){
  let html=GCAL_FIELDS.map(f=>`<div class="cal-legend-item"><span class="cal-legend-dot" style="background:${CAL_COLORS[f.key]}"></span>${f.label}</div>`).join('');
  if(gcalIsConnected())html+=`<div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--s2);border:1px dashed var(--border);"></span>On Google Calendar, not linked to a case</div>`;
  document.getElementById('calLegend').innerHTML=html;
}
function calNav(dir){
  const a=new Date(calState.anchor);a.setDate(a.getDate()+dir*28);
  calState.anchor=a;calRender();
}
function calToday(){calState.anchor=new Date();calRender();}
function calRender(){calRenderLegend();calRenderWeek();if(gcalIsConnected())calLoadUntracked();}

function calRenderWeek(){
  // Shows 4 consecutive weeks stacked, starting from the Monday of the anchor's week.
  const idx=calBuildIndex();
  const anchor=new Date(calState.anchor);
  const dow=(anchor.getDay()+6)%7;
  const blockStart=new Date(anchor);blockStart.setDate(anchor.getDate()-dow);
  const blockEnd=new Date(blockStart);blockEnd.setDate(blockStart.getDate()+27);
  const fmt=d=>d.toISOString().split('T')[0];
  document.getElementById('calRangeLabel').textContent=`${blockStart.toLocaleDateString('en-US',{month:'short',day:'numeric'})} – ${blockEnd.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}`;
  const todayStr=new Date().toISOString().split('T')[0];
  let html='';
  for(let w=0;w<4;w++){
    const weekStart=new Date(blockStart);weekStart.setDate(blockStart.getDate()+w*7);
    const days=[];for(let i=0;i<7;i++){const d=new Date(weekStart);d.setDate(weekStart.getDate()+i);days.push(d);}
    const weekLabel=`${days[0].toLocaleDateString('en-US',{month:'short',day:'numeric'})} – ${days[6].toLocaleDateString('en-US',{month:'short',day:'numeric'})}`;
    html+=`<div class="cal-week-label">${weekLabel}</div><div class="cal-week">`;
    days.forEach(d=>{
      const dateStr=fmt(d);
      const evs=idx[dateStr]||[];
      const isToday=dateStr===todayStr;
      const chips=evs.map(e=>`<div class="cal-chip" style="background:${CAL_COLORS[e.type]}22;color:${CAL_COLORS[e.type]};" onclick="openDet('${e.caseId}')">${e.name}<div style="opacity:.7;font-weight:600;">${e.label}</div></div>`).join('');
      html+=`<div class="cal-daycol${isToday?' cal-cell-today':''}" id="cal-day-${dateStr}"><div class="cal-daylabel">${d.toLocaleDateString('en-US',{weekday:'short'})} ${d.getDate()}</div><div class="cal-chip-list" id="cal-chiplist-${dateStr}">${chips}</div></div>`;
    });
    html+='</div>';
  }
  document.getElementById('calWeekGrid').innerHTML=html;
}

async function calLoadUntracked(){
  const token=await gcalEnsureToken();if(!token)return;
  const anchor=new Date(calState.anchor);
  const dow=(anchor.getDay()+6)%7;
  const blockStart=new Date(anchor);blockStart.setDate(anchor.getDate()-dow);blockStart.setHours(0,0,0,0);
  const blockEnd=new Date(blockStart);blockEnd.setDate(blockStart.getDate()+28);
  const calId=encodeURIComponent(gcalCfg.calId||'primary');
  let events=[],pageToken='';
  try{
    do{
      const url=`https://www.googleapis.com/calendar/v3/calendars/${calId}/events?timeMin=${encodeURIComponent(blockStart.toISOString())}&timeMax=${encodeURIComponent(blockEnd.toISOString())}&singleEvents=true&maxResults=250${pageToken?'&pageToken='+pageToken:''}`;
      const r=await fetch(url,{headers:{'Authorization':'Bearer '+token}});
      if(!r.ok)return;
      const d=await r.json();
      events=events.concat(d.items||[]);pageToken=d.nextPageToken||'';
    }while(pageToken);
  }catch(e){return;}
  events.forEach(ev=>{
    if(ev.status==='cancelled')return;
    const p=ev.extendedProperties&&ev.extendedProperties.private;
    if(p&&p.tcCaseId)return; // already shown as a linked case chip
    const dateStr=ev.start&&(ev.start.date||(ev.start.dateTime||'').split('T')[0]);
    const list=dateStr&&document.getElementById('cal-chiplist-'+dateStr);
    if(!list)return;
    const title=(ev.summary||'(no title)').replace(/</g,'&lt;');
    const chip=document.createElement('a');
    chip.className='cal-chip cal-chip-untracked';
    chip.textContent=title;
    if(ev.htmlLink){chip.href=ev.htmlLink;chip.target='_blank';chip.rel='noopener';}
    list.appendChild(chip);
  });
}

let _gcalPollTimer=null;

function gcalIsConnected(){return !!(gcalCfg.clientId&&gcalTokens.refresh);}
function updateGcalPill(){const p=document.getElementById('gcalPill'),l=document.getElementById('gcalLabel');if(!p||!l)return;if(gcalIsConnected()){p.className='gcal-pill on';l.textContent='Cal Connected ✓';}else{p.className='gcal-pill off';l.textContent='Calendar';}}
function saveGcalCfg(){gcalCfg.clientId=document.getElementById('gcal_clientId').value.trim();gcalCfg.clientSecret=document.getElementById('gcal_clientSecret').value.trim();gcalCfg.calId=document.getElementById('gcal_calId').value.trim()||'primary';localStorage.setItem('sgv8_gcal',JSON.stringify(gcalCfg));updateGcalPill();const st=document.getElementById('gcalStatus');st.className='cfg-status show ok';st.textContent='✓ Settings saved. Click Connect Google Calendar.';}
function clearGcal(){if(!confirm('Disconnect Google Calendar? This stops pushing/pulling dates but does not delete existing events.'))return;gcalCfg={};gcalTokens={access:null,refresh:null,expires:0};localStorage.removeItem('sgv8_gcal');localStorage.removeItem(GCAL_TOK_KEY);if(_gcalPollTimer){clearInterval(_gcalPollTimer);_gcalPollTimer=null;}updateGcalPill();closeSettings();toast('Calendar disconnected');}

function gcalRandStr(len){const arr=new Uint8Array(len);crypto.getRandomValues(arr);return Array.from(arr,b=>('0'+b.toString(16)).slice(-2)).join('');}
async function gcalChallenge(verifier){const enc=new TextEncoder().encode(verifier);const digest=await crypto.subtle.digest('SHA-256',enc);return btoa(String.fromCharCode(...new Uint8Array(digest))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}

async function gcalAuthorize(){
  const clientId=document.getElementById('gcal_clientId').value.trim()||gcalCfg.clientId;
  if(!clientId){const st=document.getElementById('gcalStatus');st.className='cfg-status show err';st.textContent='✗ Enter your Google Client ID first.';return;}
  gcalCfg.clientId=clientId;
  gcalCfg.clientSecret=document.getElementById('gcal_clientSecret').value.trim()||gcalCfg.clientSecret||'';
  gcalCfg.calId=document.getElementById('gcal_calId').value.trim()||'primary';
  localStorage.setItem('sgv8_gcal',JSON.stringify(gcalCfg));
  const verifier=gcalRandStr(32);
  const challenge=await gcalChallenge(verifier);
  const redirect=window.location.href.split('?')[0].split('#')[0];
  const scope=encodeURIComponent('https://www.googleapis.com/auth/calendar.events');
  const authUrl=`https://accounts.google.com/o/oauth2/v2/auth?client_id=${encodeURIComponent(clientId)}&redirect_uri=${encodeURIComponent(redirect)}&response_type=code&scope=${scope}&access_type=offline&prompt=consent&code_challenge=${challenge}&code_challenge_method=S256&login_hint=treatment%40tcdentallab.com`;
  const popup=window.open(authUrl,'gcal_auth','width=500,height=650,left=200,top=100');
  document.getElementById('gcalAuthStatus').textContent='Waiting for Google...';
  const poll=setInterval(()=>{
    try{
      if(!popup||popup.closed){clearInterval(poll);return;}
      const url=new URL(popup.location.href);
      if(url.searchParams.has('code')){
        clearInterval(poll);
        const code=url.searchParams.get('code');
        popup.close();
        gcalExchangeCode(code,verifier,redirect);
      }else if(url.searchParams.has('error')){
        clearInterval(poll);popup.close();
        const st=document.getElementById('gcalStatus');st.className='cfg-status show err';st.textContent='✗ Google denied access: '+url.searchParams.get('error');
      }
    }catch(e){/* cross-origin until Google redirects back to our own URL — expected */}
  },500);
}

async function gcalExchangeCode(code,verifier,redirect){
  const st=document.getElementById('gcalStatus');
  st.className='cfg-status show';st.textContent='Connecting...';
  try{
    const body=new URLSearchParams({client_id:gcalCfg.clientId,code,code_verifier:verifier,grant_type:'authorization_code',redirect_uri:redirect});
    if(gcalCfg.clientSecret)body.set('client_secret',gcalCfg.clientSecret);
    const r=await fetch('https://oauth2.googleapis.com/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});
    const d=await r.json();
    if(!r.ok||!d.access_token)throw new Error(d.error_description||d.error||'Token exchange failed');
    gcalTokens.access=d.access_token;
    if(d.refresh_token)gcalTokens.refresh=d.refresh_token; // Google only sends this on first consent
    gcalTokens.expires=Date.now()+((d.expires_in||3600)*1000);
    if(!gcalTokens.refresh){st.className='cfg-status show err';st.textContent='✗ No refresh token returned. Disconnect, then reconnect (Google only issues one on first consent — if this account already granted access before, remove it under myaccount.google.com/permissions and try again).';return;}
    localStorage.setItem(GCAL_TOK_KEY,JSON.stringify(gcalTokens));
    updateGcalPill();
    st.className='cfg-status show ok';st.textContent='✓ Google Calendar connected!';
    document.getElementById('gcalAuthStatus').textContent='✓ Authorized — 2-way sync active.';
    toast('📅 Google Calendar connected');
    gcalStartPolling();
    gcalPullAll();
  }catch(e){
    st.className='cfg-status show err';st.textContent='✗ Connection failed: '+e.message;
  }
}

async function gcalEnsureToken(){
  if(!gcalTokens.refresh)return null;
  if(gcalTokens.access&&Date.now()<gcalTokens.expires-60000)return gcalTokens.access;
  try{
    const body=new URLSearchParams({client_id:gcalCfg.clientId,refresh_token:gcalTokens.refresh,grant_type:'refresh_token'});
    if(gcalCfg.clientSecret)body.set('client_secret',gcalCfg.clientSecret);
    const r=await fetch('https://oauth2.googleapis.com/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});
    const d=await r.json();
    if(!r.ok||!d.access_token)throw new Error('refresh failed');
    gcalTokens.access=d.access_token;gcalTokens.expires=Date.now()+((d.expires_in||3600)*1000);
    localStorage.setItem(GCAL_TOK_KEY,JSON.stringify(gcalTokens));
    return gcalTokens.access;
  }catch(e){
    updateGcalPill();
    return null;
  }
}

async function gcalUpsertCaseEvent(c,fieldKey,label){
  const token=await gcalEnsureToken();if(!token)return false;
  const dateVal=c[fieldKey];
  c.gcalEvents=c.gcalEvents||{};
  const calId=encodeURIComponent(gcalCfg.calId||'primary');
  const existingId=c.gcalEvents[fieldKey];
  if(!dateVal){
    if(existingId){try{await fetch(`https://www.googleapis.com/calendar/v3/calendars/${calId}/events/${existingId}`,{method:'DELETE',headers:{'Authorization':'Bearer '+token}});}catch(e){}delete c.gcalEvents[fieldKey];return true;}
    return false;
  }
  const body={summary:`${c.pt||'Unnamed'} — ${label}`,description:`Doctor: ${c.dr||''}\nCase: ${c.id}\nSynced from TC Dental Lab Surgical Guide Tracker.`,start:{date:dateVal},end:{date:dateVal},extendedProperties:{private:{tcCaseId:c.id,tcField:fieldKey}}};
  try{
    let r;
    if(existingId){
      r=await fetch(`https://www.googleapis.com/calendar/v3/calendars/${calId}/events/${existingId}`,{method:'PATCH',headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(body)});
      if(r.status===404)r=await fetch(`https://www.googleapis.com/calendar/v3/calendars/${calId}/events`,{method:'POST',headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(body)});
    }else{
      r=await fetch(`https://www.googleapis.com/calendar/v3/calendars/${calId}/events`,{method:'POST',headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(body)});
    }
    const d=await r.json();
    if(r.ok&&d.id){c.gcalEvents[fieldKey]=d.id;return true;}
  }catch(e){/* calendar sync is best-effort; case save itself already succeeded */}
  return false;
}

async function gcalSyncCase(c,autoPersist){
  if(!gcalIsConnected())return;
  let changed=false;
  for(const f of GCAL_FIELDS){const did=await gcalUpsertCaseEvent(c,f.key,f.label);if(did)changed=true;}
  if(changed&&autoPersist!==false){const idx=cases.findIndex(x=>x.id===c.id);if(idx!==-1)cases[idx]=c;localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));_persistCaseCore(c).catch(()=>{});}
}

async function gcalSyncAll(){
  if(!gcalIsConnected()){const st=document.getElementById('gcalStatus');st.className='cfg-status show err';st.textContent='✗ Connect Google Calendar first.';return;}
  const st=document.getElementById('gcalStatus');st.className='cfg-status show';st.textContent=`Pushing 0/${cases.length} cases...`;
  let i=0;
  for(const c of cases){i++;await gcalSyncCase(c,false);st.textContent=`Pushing ${i}/${cases.length} cases...`;}
  localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));
  if(isConnected()&&_sha.casesLoaded){
    try{const fresh=await ghRead('cases.json');if(fresh.sha)_sha.cases=fresh.sha;const merged=[...(fresh.content||[])];cases.forEach(lc=>{const idx=merged.findIndex(x=>x.id===lc.id);if(idx!==-1)merged[idx]=lc;else merged.push(lc);});cases=merged;const res=await ghWrite('cases.json',cases,_sha.cases,'Bulk sync to Google Calendar');_sha.cases=res.content.sha;}catch(e){}
  }
  st.className='cfg-status show ok';st.textContent=`✓ Pushed ${cases.length} cases to Google Calendar.`;
  render();toast('📅 All cases pushed to calendar');
}

async function gcalPullAll(){
  if(!gcalIsConnected())return;
  const token=await gcalEnsureToken();if(!token)return;
  const calId=encodeURIComponent(gcalCfg.calId||'primary');
  const timeMin=new Date(Date.now()-90*86400000).toISOString();
  const timeMax=new Date(Date.now()+540*86400000).toISOString();
  let events=[],pageToken='';
  try{
    do{
      const url=`https://www.googleapis.com/calendar/v3/calendars/${calId}/events?timeMin=${encodeURIComponent(timeMin)}&timeMax=${encodeURIComponent(timeMax)}&singleEvents=true&showDeleted=true&maxResults=250${pageToken?'&pageToken='+pageToken:''}`;
      const r=await fetch(url,{headers:{'Authorization':'Bearer '+token}});
      if(!r.ok)break;
      const d=await r.json();
      events=events.concat(d.items||[]);pageToken=d.nextPageToken||'';
    }while(pageToken);
  }catch(e){return;}
  let changed=false;
  events.forEach(ev=>{
    const p=ev.extendedProperties&&ev.extendedProperties.private;
    if(!p||!p.tcCaseId||!p.tcField)return;
    const c=cases.find(x=>x.id===p.tcCaseId);if(!c)return;
    if(ev.status==='cancelled'){if(c.gcalEvents&&c.gcalEvents[p.tcField]){delete c.gcalEvents[p.tcField];changed=true;}return;}
    const newDate=ev.start&&(ev.start.date||(ev.start.dateTime||'').split('T')[0]);
    if(newDate&&newDate!==c[p.tcField]){c[p.tcField]=newDate;c.gcalEvents=c.gcalEvents||{};c.gcalEvents[p.tcField]=ev.id;changed=true;}
  });
  if(changed){
    localStorage.setItem(LOCAL_KEY,JSON.stringify(cases));render();
    toast('📅 Pulled date changes from Google Calendar');
    if(isConnected()&&_sha.casesLoaded){
      try{const fresh=await ghRead('cases.json');if(fresh.sha)_sha.cases=fresh.sha;const merged=[...(fresh.content||[])];cases.forEach(lc=>{const idx=merged.findIndex(x=>x.id===lc.id);if(idx!==-1)merged[idx]=lc;else merged.push(lc);});cases=merged;const res=await ghWrite('cases.json',cases,_sha.cases,'Pull date changes from Google Calendar');_sha.cases=res.content.sha;}catch(e){}
    }
  }
}
function gcalPullNow(){const st=document.getElementById('gcalStatus');if(!gcalIsConnected()){st.className='cfg-status show err';st.textContent='✗ Connect Google Calendar first.';return;}st.className='cfg-status show';st.textContent='Checking for changes...';gcalPullAll().then(()=>{st.className='cfg-status show ok';st.textContent='✓ Checked for calendar changes.';});}

function closeGcalView(){document.getElementById('gcalViewOv').classList.remove('open');}
async function gcalViewEvents(){
  const ov=document.getElementById('gcalViewOv'),body=document.getElementById('gcalViewBody');
  ov.classList.add('open');
  body.innerHTML='Loading...';
  if(!gcalIsConnected()){body.innerHTML='<div style="color:var(--rose);">Connect Google Calendar first — see the Calendar tab in Settings.</div>';return;}
  const token=await gcalEnsureToken();
  if(!token){body.innerHTML='<div style="color:var(--rose);">Could not get a valid Google session — try reconnecting.</div>';return;}
  const calId=encodeURIComponent(gcalCfg.calId||'primary');
  const timeMin=new Date(Date.now()-30*86400000).toISOString();
  const timeMax=new Date(Date.now()+180*86400000).toISOString();
  let events=[],pageToken='';
  try{
    do{
      const url=`https://www.googleapis.com/calendar/v3/calendars/${calId}/events?timeMin=${encodeURIComponent(timeMin)}&timeMax=${encodeURIComponent(timeMax)}&singleEvents=true&orderBy=startTime&maxResults=250${pageToken?'&pageToken='+pageToken:''}`;
      const r=await fetch(url,{headers:{'Authorization':'Bearer '+token}});
      if(!r.ok)throw new Error('Calendar fetch failed ('+r.status+')');
      const d=await r.json();
      events=events.concat(d.items||[]);pageToken=d.nextPageToken||'';
    }while(pageToken);
  }catch(e){body.innerHTML=`<div style="color:var(--rose);">Could not load events: ${e.message}</div>`;return;}
  if(!events.length){body.innerHTML='<div>No events found in the next 6 months (or past 30 days) on this calendar.</div>';return;}
  body.innerHTML=events.map(ev=>{
    const p=ev.extendedProperties&&ev.extendedProperties.private;
    const linked=!!(p&&p.tcCaseId);
    const dateStr=ev.start&&(ev.start.date||(ev.start.dateTime||'').split('T')[0])||'—';
    const title=ev.summary||'(no title)';
    const badge=linked?`<span class="chip chip-y" style="margin-left:8px;">Linked to case</span>`:`<span class="chip chip-tbd" style="margin-left:8px;">Not linked</span>`;
    return `<div style="padding:8px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;">
      <div><div style="font-weight:700;font-size:12px;">${title}</div><div style="font-size:11px;color:var(--muted);">${dateStr}${p&&p.tcField?' · '+p.tcField:''}</div></div>
      ${badge}
    </div>`;
  }).join('');
}
function gcalStartPolling(){if(_gcalPollTimer)clearInterval(_gcalPollTimer);_gcalPollTimer=setInterval(gcalPullAll,5*60*1000);}

function initGcal(){
  gcalCfg=JSON.parse(localStorage.getItem('sgv8_gcal')||'{}');
  gcalTokens=JSON.parse(localStorage.getItem(GCAL_TOK_KEY)||'{}');
  if(!gcalTokens.access)gcalTokens={access:null,refresh:null,expires:0};
  // Google OAuth Client ID/Secret must be entered per-device in Settings — no hardcoded default (was flagged as an exposed secret).
  if(!gcalCfg.calId||(gcalCfg.calId!=='primary'&&!gcalCfg.calId.includes('@')))gcalCfg.calId='treatment@tcdentallab.com';
  localStorage.setItem('sgv8_gcal',JSON.stringify(gcalCfg));
  const cid=document.getElementById('gcal_clientId'),csec=document.getElementById('gcal_clientSecret'),ccal=document.getElementById('gcal_calId');
  if(cid)cid.value=gcalCfg.clientId||'';
  if(csec)csec.value=gcalCfg.clientSecret||'';
  if(ccal)ccal.value=gcalCfg.calId||'primary';
  updateGcalPill();
  if(gcalIsConnected()){gcalStartPolling();gcalPullAll();}
}

function downloadTemplate(){const h=SCHEMA.map(s=>s.name).join(',');const blob=new Blob([h+'\n'],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='surgical_guide_template.csv';a.click();}
function handleCSV(e){const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=ev=>{const lines=ev.target.result.split('\n').filter(l=>l.trim());const headers=parseCSVRow(lines[0]);csvImportData=[];for(let i=1;i<lines.length;i++){const vals=parseCSVRow(lines[i]);if(!vals.length)continue;const row={};headers.forEach((h,j)=>{row[h]=vals[j]||'';});const c={createdAt:new Date().toISOString().split('T')[0]};SCHEMA.forEach(s=>{const v=row[s.name]||'';if(s.key==='needsScan'||s.key==='trackFinal')c[s.key]=v.toLowerCase()==='true'||v==='1';else c[s.key]=v;});if(!c.id)c.id=genId()+'_'+i;if(!c.pt)continue;csvImportData.push(c);}document.getElementById('csvPreviewLabel').textContent=`Found ${csvImportData.length} case(s):`;document.getElementById('csvPreviewList').innerHTML=csvImportData.map(c=>`<div style="padding:4px 0;border-bottom:1px solid var(--border);font-size:12px;display:flex;gap:8px;"><span style="color:var(--muted);min-width:80px;">${c.id}</span><span style="font-weight:700;">${c.pt}</span></div>`).join('');document.getElementById('csvPreview').style.display='block';};reader.readAsText(file);}
function parseCSVRow(row){const r=[];let cur='',inQ=false;for(let i=0;i<row.length;i++){const ch=row[i];if(ch==='"'){inQ=!inQ;}else if(ch===','&&!inQ){r.push(cur.trim());cur='';}else cur+=ch;}r.push(cur.trim());return r;}
async function confirmImport(){for(const c of csvImportData)await persistCase(c);csvImportData=[];document.getElementById('csvPreview').style.display='none';document.getElementById('csvInput').value='';closeSettings();render();toast('Cases imported!');}
function cancelImport(){csvImportData=[];document.getElementById('csvPreview').style.display='none';document.getElementById('csvInput').value='';}
function exportCSV(){const h=SCHEMA.map(s=>s.name).join(',');const r=cases.map(c=>SCHEMA.map(s=>{const v=c[s.key]??'';return typeof v==='string'&&(v.includes(',')||v.includes('"'))?`"${v.replace(/"/g,'""')}"`:v;}).join(','));const blob=new Blob([h+'\n'+r.join('\n')],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`sg_cases_${new Date().toISOString().split('T')[0]}.csv`;a.click();toast('✓ Cases exported!');}
function exportJSON(){const blob=new Blob([JSON.stringify(cases,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`sg_backup_${new Date().toISOString().split('T')[0]}.json`;a.click();toast('✓ Backup downloaded!');}
function exportDoctorsCSV(){const h=['Name','Practice','Phone','Email','Contact','Turnaround','Instructions','Volume','Notes'];const r=doctors.map(d=>[d.name,d.practice,d.phone,d.email,d.contact,d.turnaround,d.instructions,d.volNotes,d.notes].map(v=>{const s=String(v||'');return s.includes(',')||s.includes('"')?`"${s.replace(/"/g,'""')}"`:s;}).join(','));const blob=new Blob([h.join(',')+'\n'+r.join('\n')],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='doctors.csv';a.click();toast('✓ Doctors exported!');}


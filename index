function caseFlags(c){
  const flags=[];
  const add=(days,label)=>flags.push({days,label});
  if(c.onHold) flags.push({days:null,label:`<i class="ph ph-pause"></i> On hold${c.holdReason?' — '+holdReasonLabel(c.holdReason):''}`});
  if(c.recDate&&c.recStatus!=='completed'){const d=du(c.recDate);if(d<0)add(d,`Records appt was ${fmt(c.recDate)} — not marked done`);}
  if(c.onlineMeetDate&&c.onlineMeetStatus!=='completed'){const d=du(c.onlineMeetDate);if(d<0)add(d,`Design meeting was ${fmt(c.onlineMeetDate)} — not marked done`);}
  else if(!c.onlineMeetDate&&c.meetDeadline&&c.onlineMeetStatus==='not-scheduled'){const d=du(c.meetDeadline);if(d<0)add(d,`Design meeting deadline (${fmt(c.meetDeadline)}) passed — never scheduled`);}
  if(c.surDate&&c.surStatus!=='completed'){const d=du(c.surDate);if(d<0)add(d,`Surgery date was ${fmt(c.surDate)} — not marked done`);}
  if(c.delDate&&c.delStatus!=='delivered'){const d=du(c.delDate);if(d<0)add(d,`Delivery was due ${fmt(c.delDate)} — not marked delivered`);}
  if(c.fuDate&&c.fuStatus==='pending'){const d=du(c.fuDate);if(d<0)add(d,`Follow-up was due ${fmt(c.fuDate)}`);}
  if(c.trackFinal&&c.finDec==='pending'&&c.finDecDate){const d=du(c.finDecDate);if(d<0)add(d,`Final restoration follow-up was due ${fmt(c.finDecDate)}`);}
  return flags;
}
function renderPriorityFlagged(){
